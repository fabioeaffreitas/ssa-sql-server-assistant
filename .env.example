
# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=AdventureWorks2025
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
# Leave these empty for Windows authentication. Required when the setting above is no.
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=yes
# Use no in production unless the SQL Server certificate is properly trusted.
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=10
SQL_QUERY_TIMEOUT=30

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_REQUEST_TIMEOUT=300
